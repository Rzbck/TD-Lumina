{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lumina Scene Review",
  "type": "object",
  "required": [
    "scene_id",
    "scene_version",
    "reviewed_at",
    "ratings",
    "notes",
    "blocking_issues",
    "decision"
  ],
  "properties": {
    "scene_id": {"type": "integer", "minimum": 1},
    "scene_version": {"type": "string"},
    "reviewed_at": {"type": "string"},
    "seed": {"type": "number"},
    "bpm": {"type": "number", "minimum": 1},
    "capture_beat": {"type": "number", "minimum": 0},
    "capture_seconds": {"type": "number", "minimum": 0},
    "audio_source": {"type": "string"},
    "music_context": {
      "type": "string",
      "enum": ["calm", "rhythmic", "energetic", "mixed", "silence-test"]
    },
    "ratings": {
      "type": "object",
      "required": [
        "architecture_readability",
        "light_shadow_balance",
        "movement_quality",
        "internal_evolution",
        "spatial_use",
        "symmetry_quality",
        "asymmetry_quality",
        "pixel_liveliness",
        "music_sync",
        "transition_quality",
        "originality",
        "performance"
      ],
      "additionalProperties": false,
      "properties": {
        "architecture_readability": {"type": "integer", "minimum": 1, "maximum": 5},
        "light_shadow_balance": {"type": "integer", "minimum": 1, "maximum": 5},
        "movement_quality": {"type": "integer", "minimum": 1, "maximum": 5},
        "internal_evolution": {"type": "integer", "minimum": 1, "maximum": 5},
        "spatial_use": {"type": "integer", "minimum": 1, "maximum": 5},
        "symmetry_quality": {"type": "integer", "minimum": 1, "maximum": 5},
        "asymmetry_quality": {"type": "integer", "minimum": 1, "maximum": 5},
        "pixel_liveliness": {"type": "integer", "minimum": 1, "maximum": 5},
        "music_sync": {"type": "integer", "minimum": 1, "maximum": 5},
        "transition_quality": {"type": "integer", "minimum": 1, "maximum": 5},
        "originality": {"type": "integer", "minimum": 1, "maximum": 5},
        "performance": {"type": "integer", "minimum": 1, "maximum": 5}
      }
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "blocking_issues": {
      "type": "array",
      "items": {"type": "string"}
    },
    "keep": {
      "type": "array",
      "items": {"type": "string"}
    },
    "change_next": {
      "type": "array",
      "items": {"type": "string"}
    },
    "decision": {
      "type": "string",
      "enum": ["REVISION", "VALIDATED", "REJECTED"]
    }
  }
}
